{
  "rewrites": [
    {
      "source": "/api/newsapi/:path*",
      "destination": "https://newsapi.org/v2/:path*"
    },
    {
      "source": "/api/mediastack/:path*",
      "destination": "http://api.mediastack.com/v1/:path*"
    },
    {
      "source": "/api/overpass/:path*",
      "destination": "https://overpass-api.de/api/:path*"
    },
    {
      "source": "/api/berita-indo/:path*",
      "destination": "https://berita-indo-api.vercel.app/v1/:path*"
    }
  ]
}